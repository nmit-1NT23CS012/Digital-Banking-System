# .gitignore

# Dependencies
node_modules/

# Environment variables
.env
.env.*
!.env.example

# IDE & Editor
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store

# Logs
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Build outputs
dist/
build/
.next/
out/

# Misc
.cache/
.parcel-cache/
.eslintcache
.stylelintcache

# OS
Thumbs.db

# Database backups
*.backup
*.dump
*.sql.gz

# Temporary files
tmp/
temp/
*.temp
